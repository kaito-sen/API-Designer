<UserControl x:Class="API_Integarated.UI.Views.ApiStudioControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:models="clr-namespace:API_Integarated.Core.Models"
             xmlns:controls="clr-namespace:API_Integarated.UI.Controls"
             xmlns:converters="clr-namespace:API_Integarated.UI.Converters"
             xmlns:viewmodels="clr-namespace:API_Integarated.UI.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=viewmodels:ApiStudioViewModel}"
             d:DesignHeight="800" d:DesignWidth="1200"
             Background="#F5F6F8"
             FontFamily="Segoe UI, Tahoma, sans-serif"
             FontSize="13">

    <UserControl.Resources>
        <converters:MethodToBrushConverter x:Key="MethodToBrushConverter" />
        <converters:StatusCodeToBrushConverter x:Key="StatusCodeToBrushConverter" />
        <converters:EqualityToVisibilityConverter x:Key="EqualityToVisibilityConverter" />
        <converters:EqualityToBooleanConverter x:Key="EqualityToBooleanConverter" />
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter" />
        <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <!-- Clean Modern Button Style -->
        <Style x:Key="ModernButtonStyle" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Foreground" Value="#334155" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F1F5F9" />
                    <Setter Property="BorderBrush" Value="#94A3B8" />
                    <Setter Property="Foreground" Value="#0F172A" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#E2E8F0" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Primary Accent Button Style -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Background" Value="#2563EB" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="BorderBrush" Value="#1D4ED8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1D4ED8" />
                    <Setter Property="BorderBrush" Value="#1E40AF" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#1E40AF" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Danger Button Style (for Delete) -->
        <Style x:Key="DangerButtonStyle" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Foreground" Value="#DC2626" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FEF2F2" />
                    <Setter Property="BorderBrush" Value="#FCA5A5" />
                    <Setter Property="Foreground" Value="#B91C1C" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#FEE2E2" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Delete Row Button Style (Trash icon with red hover) -->
        <Style x:Key="DeleteRowButtonStyle" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="ToolTip" Value="Delete this item" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="4">
                            <Path x:Name="icon" 
                                  Data="M 6 19 C 6 20.1 6.9 21 8 21 H 16 C 17.1 21 18 20.1 18 19 V 7 H 6 V 19 Z M 19 4 H 15.5 L 14.5 3 H 9.5 L 8.5 4 H 5 V 6 H 19 V 4 Z" 
                                  Fill="#94A3B8" 
                                  Width="12" Height="12" 
                                  Stretch="Uniform" 
                                  HorizontalAlignment="Center" 
                                  VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FEE2E2" />
                                <Setter TargetName="icon" Property="Fill" Value="#DC2626" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Clean TextBox Style -->
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ScrollViewer x:Name="PART_ContentHost" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#2563EB" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Modern Flat CheckBox Style -->
        <Style TargetType="CheckBox">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Foreground" Value="#1E293B" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="chkBorder" Grid.Column="0"
                                    Width="16" Height="16" 
                                    CornerRadius="3" 
                                    BorderBrush="#CBD5E1" 
                                    BorderThickness="1.5" 
                                    Background="#FFFFFF"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                                <Path x:Name="chkMark" 
                                      Data="M 3.5 8 L 6.5 11 L 12.5 4.5" 
                                      Stroke="#FFFFFF" 
                                      StrokeThickness="2" 
                                      StrokeStartLineCap="Round" 
                                      StrokeEndLineCap="Round"
                                      Visibility="Collapsed" 
                                      HorizontalAlignment="Center" 
                                      VerticalAlignment="Center" />
                            </Border>
                            <ContentPresenter x:Name="contentPresenter" Grid.Column="1" 
                                              Margin="8,0,0,0" 
                                              VerticalAlignment="Center" 
                                              RecognizesAccessKey="True" 
                                              Visibility="Collapsed" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="HasContent" Value="True">
                                <Setter TargetName="contentPresenter" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="chkBorder" Property="Background" Value="#2563EB" />
                                <Setter TargetName="chkBorder" Property="BorderBrush" Value="#2563EB" />
                                <Setter TargetName="chkMark" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="chkBorder" Property="BorderBrush" Value="#2563EB" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="chkBorder" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Flat RadioButton Style -->
        <Style TargetType="RadioButton">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Foreground" Value="#334155" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Grid Width="16" Height="16" VerticalAlignment="Center">
                                <Border x:Name="outerCircle" 
                                        Width="16" Height="16" 
                                        CornerRadius="8" 
                                        BorderBrush="#CBD5E1" 
                                        BorderThickness="1.5" 
                                        Background="#FFFFFF" />
                                <Border x:Name="innerDot" 
                                        Width="8" Height="8" 
                                        CornerRadius="4" 
                                        Background="#2563EB" 
                                        HorizontalAlignment="Center" 
                                        VerticalAlignment="Center" 
                                        Visibility="Collapsed" />
                            </Grid>
                            <ContentPresenter x:Name="contentPresenter" 
                                              Margin="8,0,0,0" 
                                              VerticalAlignment="Center" 
                                              RecognizesAccessKey="True" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="outerCircle" Property="BorderBrush" Value="#2563EB" />
                                <Setter TargetName="innerDot" Property="Visibility" Value="Visible" />
                                <Setter Property="Foreground" Value="#0F172A" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="outerCircle" Property="BorderBrush" Value="#2563EB" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="outerCircle" Property="Opacity" Value="0.5" />
                                <Setter Property="Foreground" Value="#94A3B8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Flat TabControl Style -->
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#E2E8F0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <!-- Tab Header Strip with bottom border -->
                            <Border Grid.Row="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="4,0,0,0">
                                <TabPanel IsItemsHost="True" />
                            </Border>
                            <!-- Content Area -->
                            <Border Grid.Row="1" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0">
                                <ContentPresenter ContentSource="SelectedContent" />
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Flat TabItem Style with Blue Underline -->
        <Style TargetType="TabItem">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Foreground" Value="#64748B" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Grid Background="Transparent">
                            <Border x:Name="border" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <Border x:Name="indicator" Height="2" Background="Transparent" VerticalAlignment="Bottom" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#0F172A" />
                                <Setter TargetName="border" Property="Background" Value="#F1F5F9" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="#2563EB" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Setter TargetName="indicator" Property="Background" Value="#2563EB" />
                                <Setter TargetName="border" Property="Background" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Flat DataGrid Style -->
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="RowBackground" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#E2E8F0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="RowHeaderWidth" Value="0" />
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="#F1F5F9" />
            <Setter Property="VerticalGridLinesBrush" Value="Transparent" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="#1E293B" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F8FAFC" />
            <Setter Property="Foreground" Value="#475569" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="BorderBrush" Value="#E2E8F0" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="SeparatorVisibility" Value="Collapsed" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridColumnHeader">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="BorderBrush" Value="#F1F5F9" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F8FAFC" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#EFF6FF" />
                    <Setter Property="Foreground" Value="#1E293B" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="Foreground" Value="#0F172A" />
                </Trigger>
                <Trigger Property="IsEditing" Value="True">
                    <Setter Property="Padding" Value="0" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Main Workspace -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" MinWidth="240" MaxWidth="500" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- LEFT SIDEBAR: Collections & Endpoints -->
            <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#E4E7EC" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- App Title / Header with Brand Logo -->
                    <Border Grid.Row="0" Background="#0F172A" Padding="12,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- App Logo Image Badge -->
                            <Border Grid.Column="0" Width="36" Height="36" CornerRadius="8" Margin="0,0,10,0" ClipToBounds="True" Background="#1E293B">
                                <Image Source="pack://application:,,,/API_Integarated;component/UI/Resources/app_icon.png" 
                                       Width="36" Height="36" 
                                       RenderOptions.BitmapScalingMode="HighQuality" />
                            </Border>

                            <!-- Brand Typography -->
                            <StackPanel Grid.Column="1" Orientation="Vertical" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="REST API DESIGNER" FontWeight="Bold" Foreground="#FFFFFF" FontSize="13" VerticalAlignment="Center" />
                                    <Border Background="#2563EB" CornerRadius="3" Padding="4,1" Margin="6,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="PRO" FontWeight="Bold" Foreground="#FFFFFF" FontSize="9" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="Embedded Visual Studio &amp; Runner" Foreground="#94A3B8" FontSize="11" Margin="0,2,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Collection Toolbar -->
                    <Border Grid.Row="1" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="12,10">
                        <StackPanel Orientation="Vertical">
                            <!-- Collection Name Card -->
                            <Border Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="8,4" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <!-- Folder Icon -->
                                    <Path Grid.Column="0" 
                                          Data="M 10 4 H 4 C 2.9 4 2 4.9 2 6 V 18 C 2 19.1 2.9 20 4 20 H 20 C 21.1 20 22 19.1 22 18 V 8 C 22 6.9 21.1 6 20 6 H 12 L 10 4 Z" 
                                          Fill="#64748B" 
                                          Width="14" Height="14" 
                                          Stretch="Uniform" 
                                          VerticalAlignment="Center" 
                                          Margin="2,0,8,0" />
                                    <TextBox Grid.Column="1" 
                                             Text="{Binding CollectionName, UpdateSourceTrigger=PropertyChanged}" 
                                             FontWeight="SemiBold" 
                                             FontSize="13"
                                             BorderThickness="0"
                                             Background="Transparent"
                                             Padding="0,2"
                                             ToolTip="Collection Name (Click to edit)" />
                                </Grid>
                            </Border>

                            <!-- Primary Button: + New Request -->
                            <Button Command="{Binding AddEndpointCommand}" 
                                    Style="{StaticResource PrimaryButtonStyle}" 
                                    Margin="0,0,0,6" 
                                    Height="32"
                                    HorizontalContentAlignment="Center"
                                    ToolTip="Add new API request">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="M 19 13 H 13 V 19 H 11 V 13 H 5 V 11 H 11 V 5 H 13 V 11 H 19 Z" 
                                          Fill="#FFFFFF" 
                                          Width="12" Height="12" 
                                          Stretch="Uniform" 
                                          Margin="0,0,6,0" />
                                    <TextBlock Text="New Request" FontWeight="SemiBold" FontSize="12" />
                                </StackPanel>
                            </Button>

                            <!-- Action Toolbar: Copy, Delete, Save, Load -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Copy -->
                                <Button Grid.Column="0" Command="{Binding CloneEndpointCommand}" Style="{StaticResource ModernButtonStyle}" Margin="0,0,3,0" Padding="0,5" ToolTip="Duplicate selected request">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Path Data="M 16 1 H 4 C 2.9 1 2 1.9 2 3 V 17 H 4 V 3 H 16 V 1 Z M 19 5 H 8 C 6.9 5 6 5.9 6 7 V 21 C 6 22.1 6.9 23 8 23 H 19 C 20.1 23 21 22.1 21 21 V 7 C 21 5.9 20.1 5 19 5 Z M 19 21 H 8 V 7 H 19 V 21 Z" 
                                              Fill="#475569" Width="11" Height="11" Stretch="Uniform" Margin="0,0,4,0" />
                                        <TextBlock Text="Copy" FontSize="11" />
                                    </StackPanel>
                                </Button>

                                <!-- Delete -->
                                <Button Grid.Column="1" Command="{Binding DeleteEndpointCommand}" Style="{StaticResource DangerButtonStyle}" Margin="0,0,3,0" Padding="0,5" ToolTip="Delete selected request">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Path Data="M 6 19 C 6 20.1 6.9 21 8 21 H 16 C 17.1 21 18 20.1 18 19 V 7 H 6 V 19 Z M 19 4 H 15.5 L 14.5 3 H 9.5 L 8.5 4 H 5 V 6 H 19 V 4 Z" 
                                              Fill="#DC2626" Width="11" Height="11" Stretch="Uniform" Margin="0,0,4,0" />
                                        <TextBlock Text="Delete" FontSize="11" Foreground="#DC2626" />
                                    </StackPanel>
                                </Button>

                                <!-- Save -->
                                <Button Grid.Column="2" Command="{Binding SaveCollectionCommand}" Style="{StaticResource ModernButtonStyle}" Margin="0,0,3,0" Padding="0,5" ToolTip="Save collection to JSON file">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Path Data="M 17 3 H 5 C 3.9 3 3 3.9 3 5 V 19 C 3 20.1 3.9 21 5 21 H 19 C 20.1 21 21 20.1 21 19 V 7 L 17 3 Z M 12 19 C 10.3 19 9 17.7 9 16 C 9 14.3 10.3 13 12 13 C 13.7 13 15 14.3 15 16 C 15 17.7 13.7 19 12 19 Z M 15 9 H 5 V 5 H 15 V 9 Z" 
                                              Fill="#475569" Width="11" Height="11" Stretch="Uniform" Margin="0,0,4,0" />
                                        <TextBlock Text="Save" FontSize="11" />
                                    </StackPanel>
                                </Button>

                                <!-- Load -->
                                <Button Grid.Column="3" Command="{Binding LoadCollectionCommand}" Style="{StaticResource ModernButtonStyle}" Padding="0,5" ToolTip="Load collection from JSON file">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Path Data="M 20 6 H 12 L 10 4 H 4 C 2.9 4 2 4.9 2 6 V 18 C 2 19.1 2.9 20 4 20 H 20 C 21.1 20 22 19.1 22 18 V 8 C 22 6.9 21.1 6 20 6 Z M 20 18 H 4 V 8 H 20 V 18 Z" 
                                              Fill="#475569" Width="11" Height="11" Stretch="Uniform" Margin="0,0,4,0" />
                                        <TextBlock Text="Load" FontSize="11" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Endpoints List -->
                    <ListBox Grid.Row="2"
                             ItemsSource="{Binding Endpoints}"
                             SelectedItem="{Binding SelectedEndpoint}"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="8,8" />
                                <Setter Property="Margin" Value="2,1" />
                                <Setter Property="Cursor" Value="Hand" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type viewmodels:EndpointItemViewModel}">
                                <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="4" Padding="8,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <!-- HTTP Method Badge -->
                                        <Border Grid.Column="0" 
                                                Background="{Binding Method, Converter={StaticResource MethodToBrushConverter}}" 
                                                CornerRadius="3" 
                                                Padding="6,2" 
                                                VerticalAlignment="Center"
                                                Margin="0,0,8,0">
                                            <TextBlock Text="{Binding Method}" 
                                                       Foreground="#FFFFFF" 
                                                       FontWeight="Bold" 
                                                       FontSize="11" />
                                        </Border>
                                        <!-- Endpoint Info -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Url}" Foreground="#64748B" FontSize="11" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Environment Variables Drawer/Expander -->
                    <Expander Grid.Row="3" Header="Environment Variables ({{var}})" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="8">
                        <StackPanel MaxHeight="220">
                            <DataGrid ItemsSource="{Binding EnvironmentVariables}"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      HeadersVisibility="Column"
                                      BorderThickness="1"
                                      BorderBrush="#E2E8F0"
                                      MaxHeight="150"
                                      Margin="0,0,0,6">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="Active" Width="55">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox IsChecked="{Binding IsEnabled, UpdateSourceTrigger=PropertyChanged}" 
                                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Variable" Binding="{Binding Key}" Width="100" />
                                    <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="*" />
                                    <DataGridTemplateColumn Width="40">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource DeleteRowButtonStyle}"
                                                        Command="{Binding DataContext.RemoveEnvVarCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                            <Button Command="{Binding AddEnvVarCommand}" Style="{StaticResource ModernButtonStyle}" HorizontalAlignment="Left" Padding="8,4">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M 19 13 H 13 V 19 H 11 V 13 H 5 V 11 H 11 V 5 H 13 V 11 H 19 Z" 
                                          Fill="#2563EB" Width="10" Height="10" Stretch="Uniform" Margin="0,0,5,0" />
                                    <TextBlock Text="Add Variable" FontSize="11" FontWeight="SemiBold" Foreground="#2563EB" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Expander>
                </Grid>
            </Border>

            <!-- Left Sidebar Splitter -->
            <GridSplitter Grid.Column="1" 
                          Width="6" 
                          HorizontalAlignment="Center" 
                          VerticalAlignment="Stretch" 
                          ResizeDirection="Columns" 
                          ResizeBehavior="PreviousAndNext" 
                          Background="Transparent" 
                          Cursor="SizeWE">
                <GridSplitter.Template>
                    <ControlTemplate TargetType="GridSplitter">
                        <Border Background="Transparent">
                            <Border x:Name="bar" Width="1" Background="#E2E8F0" HorizontalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bar" Property="Background" Value="#2563EB" />
                                <Setter TargetName="bar" Property="Width" Value="2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </GridSplitter.Template>
            </GridSplitter>

            <!-- RIGHT MAIN PANEL: Request Editor & Response Viewer -->
            <Grid Grid.Column="2" Margin="12,10,12,6" DataContext="{Binding SelectedEndpoint}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="3*" MinHeight="140" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="2*" MinHeight="120" />
                </Grid.RowDefinitions>

                <!-- 1. Endpoint Name Header -->
                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" 
                             FontSize="16" 
                             FontWeight="Bold" 
                             BorderThickness="0,0,0,1" 
                             BorderBrush="#CBD5E1"
                             Background="Transparent" 
                             Padding="2,4" />
                </Grid>

                <!-- 2. HTTP Method & URL Bar + Send Button -->
                <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="6" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="100" />
                        </Grid.ColumnDefinitions>

                        <!-- Method ComboBox -->
                        <ComboBox Grid.Column="0" 
                                  SelectedItem="{Binding Method}"
                                  FontSize="13" 
                                  FontWeight="Bold" 
                                  Margin="0,0,6,0" 
                                  VerticalContentAlignment="Center">
                            <ComboBox.ItemsSource>
                                <x:Array Type="{x:Type models:ApiMethod}">
                                    <models:ApiMethod>GET</models:ApiMethod>
                                    <models:ApiMethod>POST</models:ApiMethod>
                                    <models:ApiMethod>PUT</models:ApiMethod>
                                    <models:ApiMethod>DELETE</models:ApiMethod>
                                    <models:ApiMethod>PATCH</models:ApiMethod>
                                    <models:ApiMethod>HEAD</models:ApiMethod>
                                    <models:ApiMethod>OPTIONS</models:ApiMethod>
                                </x:Array>
                            </ComboBox.ItemsSource>
                        </ComboBox>

                        <!-- URL Input -->
                        <TextBox Grid.Column="1" 
                                 Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}" 
                                 FontSize="13" 
                                 Margin="0,0,6,0" 
                                 ToolTip="Endpoint URL (supports variables like {{baseUrl}}/api/devices)" />

                        <!-- Send Button -->
                        <Button Grid.Column="2" 
                                Content="SEND" 
                                Command="{Binding DataContext.SendRequestCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                Style="{StaticResource PrimaryButtonStyle}" 
                                Height="34" />
                    </Grid>
                </Border>

                <!-- 3. REQUEST CONFIGURATION TABS -->
                <TabControl Grid.Row="2" SelectedIndex="{Binding DataContext.SelectedRequestTabIndex, RelativeSource={RelativeSource AncestorType=UserControl}}" Background="#FFFFFF" BorderBrush="#E2E8F0">
                    
                    <!-- TAB: PARAMS -->
                    <TabItem Header="Params (Query)">
                        <Grid Margin="12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                                <Button Command="{Binding DataContext.AddQueryParamCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                        Style="{StaticResource ModernButtonStyle}" Padding="10,5">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="M 19 13 H 13 V 19 H 11 V 13 H 5 V 11 H 11 V 5 H 13 V 11 H 19 Z" 
                                              Fill="#2563EB" Width="10" Height="10" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Add Parameter" FontWeight="SemiBold" Foreground="#2563EB" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                            <DataGrid Grid.Row="1" 
                                      ItemsSource="{Binding QueryParameters}" 
                                      AutoGenerateColumns="False" 
                                      CanUserAddRows="False"
                                      HeadersVisibility="Column"
                                      BorderBrush="#E2E8F0">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="Active" Width="55">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox IsChecked="{Binding IsEnabled, UpdateSourceTrigger=PropertyChanged}" 
                                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Key" Binding="{Binding Key}" Width="180" />
                                    <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="*" />
                                    <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*" />
                                    <DataGridTemplateColumn Width="46">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource DeleteRowButtonStyle}"
                                                        Command="{Binding DataContext.RemoveQueryParamCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </TabItem>

                    <!-- TAB: AUTHORIZATION -->
                    <TabItem Header="Authorization">
                        <Grid Margin="12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,14">
                                <TextBlock Text="Auth Type:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0" />
                                <ComboBox SelectedItem="{Binding AuthType}" Width="180">
                                    <ComboBox.ItemsSource>
                                        <x:Array Type="{x:Type models:ApiAuthType}">
                                            <models:ApiAuthType>None</models:ApiAuthType>
                                            <models:ApiAuthType>BearerToken</models:ApiAuthType>
                                            <models:ApiAuthType>ApiKey</models:ApiAuthType>
                                            <models:ApiAuthType>BasicAuth</models:ApiAuthType>
                                            <models:ApiAuthType>CustomHeader</models:ApiAuthType>
                                        </x:Array>
                                    </ComboBox.ItemsSource>
                                </ComboBox>
                            </StackPanel>

                            <!-- Sub-panel: Bearer Token -->
                            <StackPanel Grid.Row="1" Visibility="{Binding AuthType, Converter={StaticResource EqualityToVisibilityConverter}, ConverterParameter=BearerToken}">
                                <TextBlock Text="Token (Supports {{token}}):" Margin="0,0,0,4" FontWeight="SemiBold" />
                                <TextBox Text="{Binding BearerToken, UpdateSourceTrigger=PropertyChanged}" Width="500" HorizontalAlignment="Left" />
                            </StackPanel>

                            <!-- Sub-panel: API Key -->
                            <StackPanel Grid.Row="1" Visibility="{Binding AuthType, Converter={StaticResource EqualityToVisibilityConverter}, ConverterParameter=ApiKey}">
                                <Grid Width="500" HorizontalAlignment="Left">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Key Name:" VerticalAlignment="Center" Margin="0,0,0,8" />
                                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding ApiKeyName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" />

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Key Value:" VerticalAlignment="Center" Margin="0,0,0,8" />
                                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding ApiKeyValue, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" />

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Send In:" VerticalAlignment="Center" />
                                    <ComboBox Grid.Row="2" Grid.Column="1" SelectedItem="{Binding ApiKeyLocation}">
                                        <ComboBox.ItemsSource>
                                            <x:Array Type="{x:Type models:ApiKeyLocation}">
                                                <models:ApiKeyLocation>Header</models:ApiKeyLocation>
                                                <models:ApiKeyLocation>QueryString</models:ApiKeyLocation>
                                            </x:Array>
                                        </ComboBox.ItemsSource>
                                    </ComboBox>
                                </Grid>
                            </StackPanel>

                            <!-- Sub-panel: Basic Auth -->
                            <StackPanel Grid.Row="1" Visibility="{Binding AuthType, Converter={StaticResource EqualityToVisibilityConverter}, ConverterParameter=BasicAuth}">
                                <Grid Width="500" HorizontalAlignment="Left">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Username:" VerticalAlignment="Center" Margin="0,0,0,8" />
                                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding BasicUsername, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" />

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Password:" VerticalAlignment="Center" />
                                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding BasicPassword, UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>
                            </StackPanel>

                            <!-- Sub-panel: Custom Header -->
                            <StackPanel Grid.Row="1" Visibility="{Binding AuthType, Converter={StaticResource EqualityToVisibilityConverter}, ConverterParameter=CustomHeader}">
                                <Grid Width="500" HorizontalAlignment="Left">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Header Name:" VerticalAlignment="Center" Margin="0,0,0,8" />
                                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding CustomHeaderName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" />

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Header Value:" VerticalAlignment="Center" />
                                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding CustomHeaderValue, UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </TabItem>

                    <!-- TAB: HEADERS -->
                    <TabItem Header="Headers">
                        <Grid Margin="12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                                <Button Command="{Binding DataContext.AddHeaderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                        Style="{StaticResource ModernButtonStyle}" Padding="10,5">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="M 19 13 H 13 V 19 H 11 V 13 H 5 V 11 H 11 V 5 H 13 V 11 H 19 Z" 
                                              Fill="#2563EB" Width="10" Height="10" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Add Header" FontWeight="SemiBold" Foreground="#2563EB" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                            <DataGrid Grid.Row="1" 
                                      ItemsSource="{Binding Headers}" 
                                      AutoGenerateColumns="False" 
                                      CanUserAddRows="False"
                                      HeadersVisibility="Column"
                                      BorderBrush="#E2E8F0">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="Active" Width="55">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox IsChecked="{Binding IsEnabled, UpdateSourceTrigger=PropertyChanged}" 
                                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Key" Binding="{Binding Key}" Width="200" />
                                    <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="*" />
                                    <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*" />
                                    <DataGridTemplateColumn Width="46">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource DeleteRowButtonStyle}"
                                                        Command="{Binding DataContext.RemoveHeaderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </TabItem>

                    <!-- TAB: REQUEST BODY -->
                    <TabItem Header="Body">
                        <Grid Margin="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- Body Type Radio Buttons -->
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                                <RadioButton Content="none" IsChecked="{Binding BodyType, Converter={StaticResource EqualityToBooleanConverter}, ConverterParameter=None}" GroupName="BodyType" Margin="0,0,16,0" Click="OnBodyTypeNoneChecked" />
                                <RadioButton Content="JSON (application/json)" IsChecked="{Binding BodyType, Converter={StaticResource EqualityToBooleanConverter}, ConverterParameter=Json}" GroupName="BodyType" Margin="0,0,16,0" Click="OnBodyTypeJsonChecked" />
                                <RadioButton Content="x-www-form-urlencoded" IsChecked="{Binding BodyType, Converter={StaticResource EqualityToBooleanConverter}, ConverterParameter=FormUrlEncoded}" GroupName="BodyType" Margin="0,0,16,0" Click="OnBodyTypeFormUrlChecked" />
                                <RadioButton Content="form-data" IsChecked="{Binding BodyType, Converter={StaticResource EqualityToBooleanConverter}, ConverterParameter=FormData}" GroupName="BodyType" Margin="0,0,16,0" Click="OnBodyTypeFormDataChecked" />
                                <RadioButton Content="raw text" IsChecked="{Binding BodyType, Converter={StaticResource EqualityToBooleanConverter}, ConverterParameter=RawText}" GroupName="BodyType" Click="OnBodyTypeRawChecked" />
                                <Button Content="Format JSON" 
                                        Command="{Binding DataContext.FormatJsonBodyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        Style="{StaticResource ModernButtonStyle}" 
                                        Margin="24,0,0,0"
                                        Visibility="{Binding BodyType, Converter={StaticResource EqualityToVisibilityConverter}, ConverterParameter=Json}" />
                                <Button Content="{Binding DataContext.GenerateModelButtonText, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                        Command="{Binding DataContext.GenerateRequestCSharpModelCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        Style="{StaticResource ModernButtonStyle}" 
                                        Margin="8,0,0,0"
                                        ToolTip="Generate and copy Request Model for selected language" />
                            </StackPanel>

                            <!-- JSON & Raw Editor (AvalonEdit) -->
                            <Border Grid.Row="1" 
                                    BorderBrush="#CBD5E1" 
                                    BorderThickness="1" 
                                    CornerRadius="4"
                                    Visibility="{Binding BodyType, Converter={StaticResource EqualityToVisibilityConverter}, ConverterParameter=Json}">
                                <controls:BindableTextEditor BindableText="{Binding RawBody, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </Border>

                            <Border Grid.Row="1" 
                                    BorderBrush="#CBD5E1" 
                                    BorderThickness="1" 
                                    CornerRadius="4"
                                    Visibility="{Binding BodyType, Converter={StaticResource EqualityToVisibilityConverter}, ConverterParameter=RawText}">
                                <controls:BindableTextEditor BindableText="{Binding RawBody, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </Border>

                            <!-- FormUrlEncoded Table -->
                            <Grid Grid.Row="1" Visibility="{Binding BodyType, Converter={StaticResource EqualityToVisibilityConverter}, ConverterParameter=FormUrlEncoded}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Button Grid.Row="0" Command="{Binding DataContext.AddFormUrlItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                        Style="{StaticResource ModernButtonStyle}" HorizontalAlignment="Left" Margin="0,0,0,8" Padding="10,5">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="M 19 13 H 13 V 19 H 11 V 13 H 5 V 11 H 11 V 5 H 13 V 11 H 19 Z" 
                                              Fill="#2563EB" Width="10" Height="10" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Add Field" FontWeight="SemiBold" Foreground="#2563EB" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <DataGrid Grid.Row="1" ItemsSource="{Binding FormUrlEncodedItems}" AutoGenerateColumns="False" CanUserAddRows="False" BorderBrush="#E2E8F0">
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="Active" Width="55">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <CheckBox IsChecked="{Binding IsEnabled, UpdateSourceTrigger=PropertyChanged}" 
                                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="Key" Binding="{Binding Key}" Width="220" />
                                        <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="*" />
                                        <DataGridTemplateColumn Width="46">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Style="{StaticResource DeleteRowButtonStyle}"
                                                            Command="{Binding DataContext.RemoveFormUrlItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>

                            <!-- FormData Table -->
                            <Grid Grid.Row="1" Visibility="{Binding BodyType, Converter={StaticResource EqualityToVisibilityConverter}, ConverterParameter=FormData}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Button Grid.Row="0" Command="{Binding DataContext.AddFormDataItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                        Style="{StaticResource ModernButtonStyle}" HorizontalAlignment="Left" Margin="0,0,0,8" Padding="10,5">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="M 19 13 H 13 V 19 H 11 V 13 H 5 V 11 H 11 V 5 H 13 V 11 H 19 Z" 
                                              Fill="#2563EB" Width="10" Height="10" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Add Field" FontWeight="SemiBold" Foreground="#2563EB" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <DataGrid Grid.Row="1" ItemsSource="{Binding FormDataItems}" AutoGenerateColumns="False" CanUserAddRows="False" BorderBrush="#E2E8F0">
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="Active" Width="55">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <CheckBox IsChecked="{Binding IsEnabled, UpdateSourceTrigger=PropertyChanged}" 
                                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="Key" Binding="{Binding Key}" Width="220" />
                                        <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="*" />
                                        <DataGridTemplateColumn Width="46">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Style="{StaticResource DeleteRowButtonStyle}"
                                                            Command="{Binding DataContext.RemoveFormDataItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>

                            <!-- None Selected Label -->
                            <TextBlock Grid.Row="1" 
                                       Text="This request does not have a body." 
                                       Foreground="#64748B" 
                                       HorizontalAlignment="Center" 
                                       VerticalAlignment="Center" 
                                       Visibility="{Binding BodyType, Converter={StaticResource EqualityToVisibilityConverter}, ConverterParameter=None}" />
                        </Grid>
                    </TabItem>

                    <!-- TAB: EXTRACTION / CHAINING -->
                    <TabItem Header="Response Extraction">
                        <Grid Margin="12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Margin="0,0,0,10">
                                <TextBlock Text="Extract values from JSON response and automatically save into Environment Variables:" Foreground="#64748B" Margin="0,0,0,8" />
                                <Button Command="{Binding DataContext.AddExtractionRuleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                        Style="{StaticResource ModernButtonStyle}" 
                                        HorizontalAlignment="Left" Padding="10,5">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="M 19 13 H 13 V 19 H 11 V 13 H 5 V 11 H 11 V 5 H 13 V 11 H 19 Z" 
                                              Fill="#2563EB" Width="10" Height="10" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Add Rule" FontWeight="SemiBold" Foreground="#2563EB" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                            <DataGrid Grid.Row="1" ItemsSource="{Binding ExtractionRules}" AutoGenerateColumns="False" CanUserAddRows="False" BorderBrush="#E2E8F0">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="Active" Width="55">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox IsChecked="{Binding IsEnabled, UpdateSourceTrigger=PropertyChanged}" 
                                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Target Variable (e.g. token)" Binding="{Binding VariableName}" Width="200" />
                                    <DataGridTextColumn Header="JSON Path (e.g. $.data.token or token)" Binding="{Binding JsonPath}" Width="250" />
                                    <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*" />
                                    <DataGridTemplateColumn Width="46">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource DeleteRowButtonStyle}"
                                                        Command="{Binding DataContext.RemoveExtractionRuleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </TabItem>

                    <!-- TAB: SETTINGS -->
                    <TabItem Header="Settings">
                        <StackPanel Margin="16" Width="400" HorizontalAlignment="Left">
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Timeout (seconds):" VerticalAlignment="Center" />
                                <TextBox Grid.Column="1" Text="{Binding TimeoutSeconds, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>
                            <CheckBox Content="Ignore SSL Certificate Errors (Self-signed certificates)" 
                                      IsChecked="{Binding IgnoreSslErrors}" />
                        </StackPanel>
                    </TabItem>
                </TabControl>

                <!-- Grid Splitter between Request and Response -->
                <GridSplitter Grid.Row="3" 
                              Height="10" 
                              HorizontalAlignment="Stretch" 
                              VerticalAlignment="Center" 
                              ResizeDirection="Rows" 
                              ResizeBehavior="PreviousAndNext" 
                              Background="Transparent" 
                              Cursor="SizeNS">
                    <GridSplitter.Template>
                        <ControlTemplate TargetType="GridSplitter">
                            <Border Background="Transparent" Padding="0,3">
                                <Grid>
                                    <!-- Subtle Horizontal Divider Line -->
                                    <Border Height="1" Background="#E2E8F0" VerticalAlignment="Center" />
                                    <!-- Center Drag Handle Grip Pill -->
                                    <Border x:Name="grip" 
                                            Width="46" Height="4" 
                                            CornerRadius="2" 
                                            Background="#CBD5E1" 
                                            HorizontalAlignment="Center" 
                                            VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="grip" Property="Background" Value="#2563EB" />
                                    <Setter TargetName="grip" Property="Width" Value="60" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </GridSplitter.Template>
                </GridSplitter>

                <!-- 4. RESPONSE INSPECTOR & TEST VIEWER -->
                <Border Grid.Row="4" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="4">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Response Summary Header -->
                        <Border Grid.Row="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="10,6">
                            <Grid DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="RESPONSE:" FontWeight="Bold" Foreground="#475569" Margin="0,0,8,0" VerticalAlignment="Center" />

                                    <!-- Status Code Badge -->
                                    <Border Background="{Binding LastResponse.StatusCode, Converter={StaticResource StatusCodeToBrushConverter}}"
                                            CornerRadius="3"
                                            Padding="6,2"
                                            Margin="0,0,8,0"
                                            Visibility="{Binding LastResponse, Converter={StaticResource NullToVisibilityConverter}}">
                                        <TextBlock Text="{Binding LastResponse.StatusCode, StringFormat='{}Status: {0}'}" 
                                                   Foreground="#FFFFFF" 
                                                   FontWeight="Bold" 
                                                   FontSize="11" />
                                    </Border>

                                    <!-- Elapsed Time Badge -->
                                    <TextBlock Text="{Binding LastResponse.ElapsedMilliseconds, StringFormat='{}Time: {0} ms'}" 
                                               Foreground="#475569" 
                                               FontWeight="SemiBold" 
                                               Margin="0,0,12,0" 
                                               VerticalAlignment="Center"
                                               Visibility="{Binding LastResponse, Converter={StaticResource NullToVisibilityConverter}}" />

                                    <!-- Content Type / Size -->
                                    <TextBlock Text="{Binding LastResponse.ContentType}" 
                                               Foreground="#64748B" 
                                               VerticalAlignment="Center"
                                               Visibility="{Binding LastResponse, Converter={StaticResource NullToVisibilityConverter}}" />
                                </StackPanel>

                                <!-- Loading / Executing Indicator -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right"
                                            Visibility="{Binding IsExecuting, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock Text="Sending request..." Foreground="#0066CC" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <Button Content="Cancel" Command="{Binding CancelRequestCommand}" Style="{StaticResource ModernButtonStyle}" Padding="6,2" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Response Tabs -->
                        <TabControl Grid.Row="1" 
                                    DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                    SelectedIndex="{Binding SelectedResponseTabIndex}"
                                    BorderThickness="0">
                            <!-- Tab Response Pretty JSON -->
                            <TabItem Header="Pretty JSON">
                                <controls:BindableTextEditor BindableText="{Binding FormattedResponseBody, Mode=OneWay}" 
                                                             IsReadOnly="True" />
                            </TabItem>

                            <!-- Tab Response Raw -->
                            <TabItem Header="Raw Body">
                                <controls:BindableTextEditor BindableText="{Binding LastResponse.ResponseBody, Mode=OneWay}" 
                                                             IsReadOnly="True" />
                            </TabItem>

                            <!-- Tab Response Headers -->
                            <TabItem Header="Headers">
                                <DataGrid ItemsSource="{Binding LastResponse.Headers}" 
                                          AutoGenerateColumns="False" 
                                          CanUserAddRows="False"
                                          HeadersVisibility="Column"
                                          BorderThickness="0"
                                          Margin="0">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Header" Binding="{Binding Key}" Width="250" />
                                        <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="*" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </TabItem>

                            <!-- Tab Code Generator (C#, TypeScript, Python) -->
                            <TabItem Header="Code Generator">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <!-- Toolbar -->
                                    <Border Grid.Row="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="12,8">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="Language:" Foreground="#475569" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold" FontSize="13" />
                                            <ComboBox SelectedIndex="{Binding SelectedLanguageIndex}" Width="120" Height="34" Margin="0,0,16,0" VerticalContentAlignment="Center" FontSize="13">
                                                <ComboBoxItem Content="C#" />
                                                <ComboBoxItem Content="TypeScript" />
                                                <ComboBoxItem Content="Python" />
                                            </ComboBox>

                                            <TextBlock Text="Mode:" Foreground="#475569" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold" FontSize="13" />
                                            <ComboBox SelectedIndex="{Binding SelectedCodeModeIndex}" Width="150" Height="34" Margin="0,0,16,0" VerticalContentAlignment="Center" FontSize="13">
                                                <ComboBoxItem Content="Response Model" />
                                                <ComboBoxItem Content="Request Model" />
                                                <ComboBoxItem Content="Full Code Snippet" />
                                            </ComboBox>

                                            <TextBlock Text="Model Name:" Foreground="#475569" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold" FontSize="13" />
                                            <TextBox Text="{Binding RootModelClassName, UpdateSourceTrigger=PropertyChanged}" Width="180" Height="34" Margin="0,0,12,0" FontWeight="SemiBold" FontSize="13" VerticalContentAlignment="Center" Padding="10,6" />
                                            
                                            <!-- Regenerate Button with Refresh Icon -->
                                            <Button Command="{Binding GenerateCSharpModelCommand}" Style="{StaticResource ModernButtonStyle}" Height="34" Padding="14,0" Margin="0,0,8,0">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Path Data="M 17.65 6.35 C 16.2 4.9 14.21 4 12 4 C 7.58 4 4.01 7.58 4.01 12 C 4.01 16.42 7.58 20 12 20 C 15.73 20 18.84 17.45 19.73 14 H 17.65 C 16.83 16.33 14.61 18 12 18 C 8.69 18 6 15.31 6 12 C 6 8.69 8.69 6 12 6 C 13.66 6 15.14 6.69 16.22 7.78 L 13 11 H 20 V 4 L 17.65 6.35 Z" 
                                                          Fill="#475569" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                    <TextBlock Text="Regenerate" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>

                                            <!-- Copy Code Button with Copy Icon -->
                                            <Button Command="{Binding CopyCSharpModelCommand}" Style="{StaticResource ModernButtonStyle}" Height="34" Padding="14,0" Margin="0,0,8,0">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Path Data="M 16 1 H 4 C 2.9 1 2 1.9 2 3 V 17 H 4 V 3 H 16 V 1 Z M 19 5 H 8 C 6.9 5 6 5.9 6 7 V 21 C 6 22.1 6.9 23 8 23 H 19 C 20.1 23 21 22.1 21 21 V 7 C 21 5.9 20.1 5 19 5 Z M 19 21 H 8 V 7 H 19 V 21 Z" 
                                                          Fill="#2563EB" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding CopyButtonText}" FontWeight="SemiBold" Foreground="#2563EB" FontSize="13" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>

                                            <!-- Export File Button with Export Icon -->
                                            <Button Command="{Binding ExportCSharpModelCommand}" Style="{StaticResource ModernButtonStyle}" Height="34" Padding="14,0">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Path Data="M 19 9 H 15 V 3 H 9 V 9 H 5 L 12 16 L 19 9 Z M 5 18 V 20 H 19 V 18 H 5 Z" 
                                                          Fill="#475569" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding ExportButtonText}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </Border>

                                    <!-- Code Viewer -->
                                    <controls:BindableTextEditor Grid.Row="1" 
                                                                 BindableText="{Binding GeneratedCSharpCode, Mode=OneWay}" 
                                                                 SyntaxLanguage="{Binding CurrentSyntaxLanguage}" 
                                                                 IsReadOnly="True" />
                                </Grid>
                            </TabItem>
                        </TabControl>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- Status Bar -->
        <Border Grid.Row="1" Background="#1E293B" Padding="12,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" Foreground="#E2E8F0" FontSize="11" />
                <TextBlock Grid.Column="1" Text="REST API Designer v1.0" Foreground="#94A3B8" FontSize="11" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
